# ========================================
# AWS PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production to git!

# ========================================
# DATABASE CONFIGURATION (TURSO)
# ========================================
# Get these from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ========================================
# AUTHENTICATION (better-auth)
# ========================================
# Generate a secure random string (minimum 32 characters)
# You can use: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long

# Your production domain (update after AWS deployment)
BETTER_AUTH_URL=https://yourdomain.com

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production

# ========================================
# OPTIONAL: AWS-SPECIFIC VARIABLES
# ========================================
# Add these if needed by your AWS setup
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# ========================================
# DEPLOYMENT NOTES
# ========================================
# 1. Copy this file to .env.production
# 2. Fill in all values
# 3. In AWS Amplify/Lambda, add these as environment variables
# 4. Update BETTER_AUTH_URL after getting your AWS domain
# 5. Never commit .env.production to git
